generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// Admin
// ────────────────────────────────────────────────────────────

model AdminUser {
  id String @id @default(cuid())

  name  String
  email String @unique

  passwordHash String

  role   AdminRole @default(ADMIN)
  active Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AdminSession[]

  @@index([role])
  @@index([active])
}

model AdminSession {
  id String @id @default(cuid())

  adminUserId String

  refreshTokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ────────────────────────────────────────────────────────────
// Training programs
// ────────────────────────────────────────────────────────────

model TrainingProgram {
  id String @id @default(cuid())

  title            String
  slug             String  @unique
  shortDescription String?
  description      String?

  price    Decimal @db.Decimal(12, 2)
  currency String  @default("NGN")

  duration     String?
  deliveryMode TrainingDeliveryMode @default(PHYSICAL)
  location     String?

  startDate            DateTime?
  endDate              DateTime?
  registrationDeadline DateTime?

  capacity Int?

  featured     Boolean @default(false)
  active       Boolean @default(true)
  displayOrder Int     @default(0)

  highlights   Json?
  curriculum   Json?
  requirements Json?
  benefits     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media         TrainingMedia[]
  registrations Registration[]
  certificateSubmissions CertificateSubmission[]
  certificates Certificate[]
  resources Resource[]

  @@index([active, displayOrder])
  @@index([featured, displayOrder])
  @@index([startDate])
  @@index([registrationDeadline])
}

model TrainingMedia {
  id String @id @default(cuid())

  trainingProgramId String

  url      String
  publicId String
  type     TrainingMediaType @default(IMAGE)

  mimeType String?
  format   String?
  bytes    Int?
  width    Int?
  height   Int?
  duration Float?

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)

  @@index([trainingProgramId, sortOrder])
  @@index([trainingProgramId, isPrimary])
  @@index([type])
}

// ────────────────────────────────────────────────────────────
// Registrations
// ────────────────────────────────────────────────────────────

model Registration {
  id String @id @default(cuid())

  name  String
  email String

  trainingProgramId String
  status            RegistrationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Restrict)

  payments Payment[]
  certificateSubmissions CertificateSubmission[]
  certificates Certificate[]

  @@unique([trainingProgramId, email])
  @@index([email])
  @@index([status, createdAt])
}

// ────────────────────────────────────────────────────────────
// Payments
// ────────────────────────────────────────────────────────────

model Payment {
  id String @id @default(cuid())

  registrationId String

  provider          PaymentProvider @default(PAYSTACK)
  reference         String          @unique
  providerReference String?         @unique

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("NGN")

  status PaymentStatus @default(PENDING)

  authorizationUrl String?
  accessCode       String?
  providerPayload  Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([status, createdAt])
}

// ────────────────────────────────────────────────────────────
// Souvenir catalogue
// ────────────────────────────────────────────────────────────

model SouvenirProduct {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?
  bookingTerms String?
  productionLeadTimeDays Int?

  active       Boolean @default(false)
  featured     Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media        SouvenirProductMedia[]
  colorOptions SouvenirColorOption[]
  priceTiers   SouvenirPriceTier[]
  orders       SouvenirOrder[]
  enquiries    SouvenirEnquiry[]

  @@index([active, displayOrder])
  @@index([featured, displayOrder])
}

model SouvenirProductMedia {
  id String @id @default(cuid())

  productId String
  url       String
  publicId  String
  altText   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product SouvenirProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

model SouvenirColorOption {
  id String @id @default(cuid())

  productId String
  name      String
  colorHex  String  @db.VarChar(7)
  swatchImageUrl String?
  swatchPublicId String?
  active    Boolean @default(true)
  displayOrder Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product SouvenirProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderSelections SouvenirOrderColor[]

  @@unique([productId, name])
  @@index([productId, active, displayOrder])
}

model SouvenirPriceTier {
  id String @id @default(cuid())

  productId String
  label      String
  minQuantity Int
  maxQuantity Int?
  totalPrice Decimal @db.Decimal(12, 2)
  currency   String  @default("NGN")
  active     Boolean @default(true)
  displayOrder Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product SouvenirProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, active, minQuantity])
}


// ────────────────────────────────────────────────────────────
// Souvenir orders and custom-design enquiries
// ────────────────────────────────────────────────────────────

model SouvenirOrder {
  id String @id @default(cuid())

  publicReference String @unique
  accessTokenHash String @unique

  customerName     String
  customerEmail    String
  customerWhatsApp String

  productId String
  priceTierId String?

  productNameSnapshot String
  priceTierLabelSnapshot String
  quantity Int
  totalPriceSnapshot Decimal @db.Decimal(12, 2)
  currency String @default("NGN")
  bookingTermsSnapshot String?
  productionLeadTimeDaysSnapshot Int?

  status SouvenirOrderStatus @default(SUBMITTED)
  customerNotes String?
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product SouvenirProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  colorSelections SouvenirOrderColor[]

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([customerWhatsApp])
}

model SouvenirOrderColor {
  id String @id @default(cuid())

  orderId String
  colorOptionId String?

  nameSnapshot String
  colorHexSnapshot String
  swatchImageUrlSnapshot String?
  quantity Int?

  createdAt DateTime @default(now())

  order SouvenirOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  colorOption SouvenirColorOption? @relation(fields: [colorOptionId], references: [id], onDelete: SetNull)

  @@unique([orderId, nameSnapshot])
  @@index([orderId])
}

model SouvenirEnquiry {
  id String @id @default(cuid())

  publicReference String @unique
  accessTokenHash String @unique

  customerName     String
  customerEmail    String
  customerWhatsApp String

  productId String?
  requestedQuantity Int?
  designDescription String
  status SouvenirEnquiryStatus @default(NEW)

  adminNotes String?
  responseMessage String?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product SouvenirProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  media SouvenirEnquiryMedia[]
  quotes SouvenirQuote[]

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([customerWhatsApp])
}

model SouvenirEnquiryMedia {
  id String @id @default(cuid())

  enquiryId String
  url String
  publicId String
  resourceType String @default("image")
  mimeType String
  bytes Int
  originalName String?

  createdAt DateTime @default(now())

  enquiry SouvenirEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
}


// ────────────────────────────────────────────────────────────
// Custom souvenir quotations
// ────────────────────────────────────────────────────────────

model SouvenirQuote {
  id String @id @default(cuid())

  enquiryId String
  version Int
  status SouvenirQuoteStatus @default(DRAFT)

  currency String @default("NGN")
  totalAmount Decimal @db.Decimal(12, 2)
  terms String?
  message String?
  expiresAt DateTime?
  sentAt DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiry SouvenirEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  items SouvenirQuoteItem[]
  media SouvenirQuoteMedia[]

  @@unique([enquiryId, version])
  @@index([enquiryId, status, createdAt])
  @@index([status, expiresAt])
}

model SouvenirQuoteItem {
  id String @id @default(cuid())

  quoteId String
  name String
  description String?
  quantity Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  quote SouvenirQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, displayOrder])
}

model SouvenirQuoteMedia {
  id String @id @default(cuid())

  quoteId String
  url String
  publicId String
  resourceType String @default("image")
  mimeType String
  bytes Int
  originalName String?

  createdAt DateTime @default(now())

  quote SouvenirQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Testimonials
// ────────────────────────────────────────────────────────────

model Testimonial {
  id String @id @default(cuid())

  name     String
  role     String?
  message  String
  rating   Int
  imageUrl String?

  status TestimonialStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([rating])
}



// ────────────────────────────────────────────────────────────
// Creative workshops and event bookings
// ────────────────────────────────────────────────────────────

model WorkshopOffering {
  id String @id @default(cuid())

  title String
  slug String @unique
  workshopType WorkshopType
  description String
  bookingTerms String?
  contactEmail String?
  contactWhatsApp String?
  active Boolean @default(false)
  featured Boolean @default(false)
  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participantTiers WorkshopParticipantTier[]
  bookings WorkshopBooking[]

  @@index([active, displayOrder])
  @@index([featured, displayOrder])
}

model WorkshopParticipantTier {
  id String @id @default(cuid())

  offeringId String
  label String
  participantCount Int
  price Decimal @db.Decimal(12, 2)
  currency String @default("NGN")
  active Boolean @default(true)
  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offering WorkshopOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  bookings WorkshopBooking[]

  @@unique([offeringId, participantCount])
  @@index([offeringId, active, participantCount])
}

model WorkshopBooking {
  id String @id @default(cuid())

  publicReference String @unique
  customerName String
  customerEmail String
  customerWhatsApp String

  offeringId String
  participantTierId String?
  workshopTitleSnapshot String
  workshopType WorkshopType
  participantCount Int
  priceSnapshot Decimal? @db.Decimal(12, 2)
  currency String @default("NGN")

  eventDate DateTime
  venueMode WorkshopVenueMode
  venueAddress String?
  city String?
  customWorkshopDescription String?
  customerNotes String?

  status WorkshopBookingStatus @default(NEW)
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offering WorkshopOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  participantTier WorkshopParticipantTier? @relation(fields: [participantTierId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([eventDate])
  @@index([customerEmail])
  @@index([customerWhatsApp])
}


model CertificateSubmission {
  id String @id @default(cuid())

  studentName String
  studentEmail String
  trainingProgramId String
  registrationId String?

  proofUrl String
  proofPublicId String
  proofOriginalName String
  proofMimeType String
  proofBytes Int

  notes String?
  status CertificateSubmissionStatus @default(PENDING)
  reviewNotes String?
  reviewedAt DateTime?
  reviewedByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Restrict)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  certificate Certificate?

  @@index([status, createdAt])
  @@index([studentEmail])
  @@index([trainingProgramId, studentEmail])
  @@index([registrationId])
}

model Certificate {
  id String @id @default(cuid())

  certificateNumber String @unique
  studentName String
  studentEmail String
  trainingProgramTitle String
  trainingProgramId String?
  registrationId String?
  submissionId String? @unique

  issuedAt DateTime @default(now())
  issuedByAdminId String
  status CertificateStatus @default(ISSUED)
  revokedAt DateTime?
  revocationReason String?

  documentUrl String
  documentPublicId String
  emailSentAt DateTime?
  lastEmailError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingProgram TrainingProgram? @relation(fields: [trainingProgramId], references: [id], onDelete: SetNull)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  submission CertificateSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([studentEmail, status])
  @@index([trainingProgramId, status])
  @@index([issuedAt])
}


model HomepageHero {
  id String @id @default(cuid())
  eyebrow String?
  heading String
  highlightText String?
  description String
  primaryCtaLabel String?
  primaryCtaUrl String?
  secondaryCtaLabel String?
  secondaryCtaUrl String?
  imageUrl String?
  imagePublicId String?
  imageAltText String?
  status SiteContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

model GalleryCategory {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  displayOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images GalleryImage[]

  @@index([active, displayOrder])
}

model GalleryImage {
  id String @id @default(cuid())
  categoryId String
  url String
  publicId String
  altText String
  caption String?
  description String?
  displayOrder Int @default(0)
  featured Boolean @default(false)
  status SiteContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, status, displayOrder])
  @@index([status, featured, displayOrder])
}

model Resource {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String?
  fileUrl String
  filePublicId String
  fileResourceType String @default("raw")
  fileFormat String @default("pdf")
  fileBytes Int
  pageCount Int?
  coverImageUrl String?
  coverImagePublicId String?
  trainingProgramId String?
  status SiteContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trainingProgram TrainingProgram? @relation(fields: [trainingProgramId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([trainingProgramId, status])
}

// ────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────

enum SiteContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum TrainingMediaType {
  IMAGE
  VIDEO
}
enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrainingDeliveryMode {
  PHYSICAL
  ONLINE
  HYBRID
}

enum RegistrationStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

enum PaymentProvider {
  PAYSTACK
}

enum SouvenirOrderStatus {
  SUBMITTED
  AWAITING_PAYMENT
  PAID
  IN_PRODUCTION
  READY
  FULFILLED
  CANCELLED
  REJECTED
}

enum SouvenirEnquiryStatus {
  NEW
  UNDER_REVIEW
  RESPONDED
  ACCEPTED
  DECLINED
  CLOSED
}

enum SouvenirQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}


enum WorkshopType {
  RESIN_ART
  LIP_CARE_FORMULATION
  CUSTOM_GROUP
}

enum WorkshopVenueMode {
  CLIENT_VENUE
  KPX_VENUE
  UNDECIDED
}


enum WorkshopBookingStatus {
  NEW
  UNDER_REVIEW
  PROPOSAL_SENT
  ACCEPTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CertificateSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}